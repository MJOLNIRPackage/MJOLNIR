license: "MPL-2.0"

keywords:
  - "inelastic neutron scattering"
  - "neutron scattering"
  - "multiplexing spectrometer"
  - "three-axis spectroscopy"
  - "CAMEA"
  - "data analysis"
  - "data treatment"
  - "visualization"

